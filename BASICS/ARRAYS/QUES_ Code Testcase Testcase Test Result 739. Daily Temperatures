class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        int n=temperatures.length;
        //creating a result array
         int []result=new int[n];
        for(int i=0;i<n;i++){
           int count=0;
           //if not found a element which is greater than found will return false
           boolean found=false;
           for(int j=i+1;j<n;j++){
                count++;
                //check is the element at j index is greater than i or not
                if(temperatures[j]>temperatures[i]){
                result[i]=count;
                found=true;
                break;
               
            }
         }   

         if(!found)
                result[i]=0;
                
     }
        return result;
        
    }
}
